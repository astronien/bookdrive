# สร้าง OAuth client ที่ https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=xxxxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-xxxxx

# npx auth secret  (หรือ openssl rand -base64 32)
# บน Vercel ไม่ต้องใส่ AUTH_URL / AUTH_TRUST_HOST — Auth.js v5 อ่าน host จาก header เอง
AUTH_SECRET=

# สำหรับ Google Picker (ฝั่ง client) — เปิด Google Picker API ใน console ด้วย
NEXT_PUBLIC_GOOGLE_API_KEY=AIzaSy-xxxxx
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
